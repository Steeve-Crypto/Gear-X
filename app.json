{
  "expo": {
    "name": "Gear X",
    "slug": "gear-x",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gearx.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Gear X needs microphone access to listen to conversations and build your living knowledge clock."
      }
    },
    "android": {
      "package": "com.gearx.app",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Gear X to access your microphone so the gears can listen and remember.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Gear X to access your microphone so the gears can listen and remember.",
          "speechRecognitionPermission": "Allow Gear X to privately turn your recordings into text."
        }
      ]
    ],
    "scheme": "gearx",
    "extra": {
      "gearXBackendUrl": ""
    }
  }
}
