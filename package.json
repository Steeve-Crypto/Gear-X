{
  "name": "gear-x",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development-android",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development-ios-device",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile development-ios-simulator",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:domain && npm run test:ui",
    "test:domain": "node --test tests/*.test.mjs",
    "test:ui": "jest --runInBand",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "validate": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/metro-runtime": "~6.1.2",
    "@react-navigation/elements": "^2.9.36",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.179.0",
    "expo": "^54.0.36",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-gl": "~16.0.10",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "^56.0.1",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "three": "^0.179.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~10.0.0",
    "jest-expo": "~54.0.17",
    "metro": "^0.83.1",
    "react-test-renderer": "19.1.0",
    "sql.js": "^1.14.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
