# Gear X mobile currently requires no bundled secrets.
# Optional public URL for a deployed Gear X backend. Provider credentials remain server-side.
# EXPO_PUBLIC_GEAR_X_BACKEND_URL=https://api.example.com
# Configure Ollama only in Developer mode in the app.
#
# Long-lived XAI_API_KEY or other provider keys belong only in a secure backend.
# A future voice backend may use these server-side variables:
# XAI_API_KEY=
# GEAR_X_ALLOWED_ORIGINS=
