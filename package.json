{
  "name": "gear-x",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development-android",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development-ios-device",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile development-ios-simulator",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:domain && npm run test:ui",
    "test:domain": "node --test tests/*.test.mjs",
    "test:ui": "jest --runInBand",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "validate": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/metro-runtime": "~55.0.12",
    "@react-navigation/elements": "^2.9.36",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.179.0",
    "expo": "^55.0.28",
    "expo-asset": "~55.0.18",
    "expo-audio": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-file-system": "~55.0.24",
    "expo-gl": "~55.0.16",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-sharing": "~55.0.22",
    "expo-speech-recognition": "^56.0.1",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "three": "^0.179.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~55.0.1",
    "jest-expo": "~55.0.20",
    "metro": "^0.83.1",
    "react-test-renderer": "19.2.0",
    "sql.js": "^1.14.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
