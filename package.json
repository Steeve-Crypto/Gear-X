{
  "name": "gear-x",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development-android",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development-ios-device",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile development-ios-simulator",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:domain && npm run test:ui",
    "test:domain": "node --test tests/*.test.mjs",
    "test:ui": "jest --runInBand",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "validate": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/metro-runtime": "~56.0.19",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.179.0",
    "expo": "^56.0.19",
    "expo-asset": "~56.0.22",
    "expo-audio": "~56.0.13",
    "expo-constants": "~56.0.23",
    "expo-dev-client": "~56.0.24",
    "expo-file-system": "~56.0.9",
    "expo-gl": "~56.0.6",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-sharing": "~56.0.24",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.8.3",
    "three": "^0.179.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~56.0.4",
    "jest-expo": "~56.0.5",
    "metro": "^0.84.2",
    "react-test-renderer": "19.2.3",
    "sql.js": "^1.14.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
