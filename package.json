{
  "name": "gear-x",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development-android",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development-ios-device",
    "build:ios:simulator": "npx eas-cli@latest build --platform ios --profile development-ios-simulator",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:domain && npm run test:ui",
    "test:backend": "node --test tests-backend/*.test.mjs",
    "test:domain": "node --test tests/*.test.mjs",
    "test:ui": "jest --runInBand",
    "test:watch": "node --test --watch tests/*.test.mjs",
    "validate": "npm run typecheck && npm run test && npm run lint"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@expo/metro-runtime": "~57.0.9",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.179.0",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.14",
    "expo-file-system": "~57.0.2",
    "expo-gl": "~57.0.2",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.14",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-purchases": "^10.7.2",
    "react-native-purchases-ui": "^10.7.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "three": "^0.179.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "ajv": "^8.17.1",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.1",
    "jest-expo": "~57.0.4",
    "metro": "^0.84.2",
    "react-test-renderer": "19.2.3",
    "sql.js": "^1.14.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
